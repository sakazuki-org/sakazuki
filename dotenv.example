# Update configurations in this file, and rename to '.env'.

### PostgreSQL.

# Hostname. default is 'localhost'.
#
# POSTGRES_HOSTNAME=localhost

# User name and password to access PostgreSQL.
#
POSTGRES_USERNAME=
POSTGRES_PASSWORD=

### JSON API

# Bearer token for creating sakes via the JSON API.
# Generate with `openssl rand -hex 32`. Leave empty to reject all token requests.
#
# API_TOKEN=

### Google AdSense

# Client ID
#
# GOOGLE_ADSENSE_CLIENT=ca-pub-00000
