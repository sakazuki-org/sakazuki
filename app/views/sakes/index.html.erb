<%= render(partial: "float_button", locals: { sake: @sake }) %>

<%= turbo_frame_tag("sakes", target: "_top", data: { turbo_action: :advance }) do %>
  <div class="row row-cols-1 g-3">
    <div class="col">
      <h1 class="mb-0" data-testid="total_sake">
        <% amount = to_shakkan(@amount) %>
        <% if !searching? then %>
          <%# 在庫一覧タイトル %>
          <% header = t(".header") %>
          <% h1 = t(".h1_with_stock", stock: amount) %>
        <% elsif search_word.present? then %>
          <%# 検索中タイトル %>
          <% header = t(".header_with_search", search: search_word) %>
          <% h1 = t(".h1_with_search", search: search_word, hit: @sakes.total_count.to_s, amount:) %>
        <% else %>
          <%# 全酒タイトル。空検索は今までに買った酒すべての一覧になる %>
          <% header = t(".header") %>
          <% h1 = t(".h1_with_all", hit: @sakes.total_count.to_s, amount:) %>
        <% end %>
        <%= title(header, h1) %>
      </h1>
    </div>
    <div class="col">
      <%= search_form_for(@search, html: { data: { turbo_frame: "sakes" } }) do |f| %>
        <div class="row mx-0 align-items-center">
          <div class="col ps-0 input-group">
            <%= f.label(:all_text_cont, "search word", class: "form-label visually-hidden") %>
            <%= f.search_field(
                  :all_text_cont,
                  class: "form-control",
                  value: params.dig(:q, :all_text_cont),
                  data: { testid: "text_search" },
                ) %>
            <%= tag.button(
                  tag.i(class: "bi-search"),
                  type: "submit",
                  class: "btn btn-primary",
                  data: { testid: "submit_search" },
                ) %>
          </div>
          <div class="col-auto">
            <%# 空検索は全酒の一覧になる。検索語なしのRansackクエリが全件を返す %>
            <%= link_to(
                  t(".all_sakes"),
                  sakes_path(q: { all_text_cont: "" }),
                  class: "btn btn-outline-secondary",
                  data: { turbo_frame: "sakes", testid: "all_sakes" },
                ) %>
          </div>
          <div class="col-lg-4 d-none d-lg-block"></div>
        </div>
      <% end %>
    </div>
    <div class="col">
      <div class="row row-cols-1 g-3">
        <div class="col">
          <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2" data-controller="simple-lightbox">
            <%= render(partial: "sake", collection: @sakes) %>
          </div>
        </div>
        <% if searching? then %>
          <div class="col" data-testid="pagination">
            <div class="d-none d-sm-block">
              <%= paginate(@sakes) %>
            </div>
            <div class="d-sm-none d-block">
              <%# HACK: 小さい画面用、表示する番号の数を少なくする
                #       kaminariを複雑にカスタムせず、2つのページネーションを生成する %>
              <%= paginate(@sakes, window: 1) %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
