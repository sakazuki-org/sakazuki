<%# locals: (sake:) %>
<div class="float-button">
  <div class="px-xxl-5 px-3 text-end">
    <% if %w[show index].include?(controller.action_name) %>
      <%= link_to(
            tag.i(class: "bi-plus-circle me-2", style: "font-size: 1.05em;") + t(".new"),
            new_sake_path,
            {
              class: "float-button-primary mx-1",
              style: "font-size: 1.1em;",
              "data-testid": "new-sake",
            },
          ) %>
    <% end %>
    <% if %w[new create edit update].include?(controller.action_name) %>
      <%= button_tag(
            type: "submit",
            form: "sake-form",
            class: "float-button-primary mx-1",
            style: "font-size: 1.1em;",
            "data-testid": "form_submit",
          ) do %>
        <%= tag.i(class: "bi-check-circle me-2") + t("submit", scope: "sakes.form.#{controller.action_name}") %>
      <% end %>
    <% end %>
  </div>
</div>
